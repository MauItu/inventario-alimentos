# Copia este archivo a .env y completa los valores. En Vercel van en Settings > Environment Variables.

# Conexión a PostgreSQL (Neon). La app usa la conexión con pooling;
# las migraciones de Prisma usan la directa (sin "-pooler" en el host).
DATABASE_URL="postgresql://usuario:password@host-pooler/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:password@host/db?sslmode=require"

# API key gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Opcional: modelo de Gemini a usar (por defecto gemini-2.5-flash)
GEMINI_MODEL=""
